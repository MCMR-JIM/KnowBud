OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DATA_ROOT=./data/library
STATE_FILE=./data/state.json
RESOURCE_INDEX_FILE=./data/resource_index.json
DECISION_LOG_FILE=./logs/decision_trace.jsonl

WHISPER_MODEL_SIZE=base
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# Voice backend mode: auto | local | docker
VOICE_BACKEND_MODE=auto

# Learning architecture mode: legacy | agent | hybrid
LEARNING_ARCH_MODE=legacy

# Rewarded off-topic exploration window duration (minutes)
EXPLORE_WINDOW_MINUTES=5

# Minimum prerequisite mastery depth required to unlock dependent topics
PREREQ_UNLOCK_DEPTH=1

# Docker ASR/TTS service endpoints (used when mode=auto/docker and URL is set)
ASR_SERVICE_URL=http://127.0.0.1:9000
TTS_SERVICE_URL=http://127.0.0.1:5501

# Runtime audio artifacts (incoming/outgoing)
AUDIO_ARTIFACT_ROOT=./artifacts/audio

LOG_LEVEL=INFO
FSM_FAIL_THRESHOLD=3
FSM_MASTER_STREAK=3
